# Copie para .env.local e preencha. NUNCA versione valores reais.
# Em ambiente local, use os valores exibidos por `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usadas apenas pelo Supabase local (config.toml) para o login com Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Email de contato para pedidos sobre dados (LGPD), mostrado em /privacidade e /termos.
# Configure na Vercel (Production e Preview); sem ele, as páginas orientam a procurar a liderança.
EMAIL_CONTATO=
